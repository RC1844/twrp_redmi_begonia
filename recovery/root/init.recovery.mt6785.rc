import /microtrust_begonia.rc

on init
    # Create a more standard /dev/block layout for our scripts
    symlink /dev/block/platform/bootdevice /dev/block/bootdevice
    export LD_LIBRARY_PATH /system/lib64:/vendor/lib64:/vendor/lib64/hw
    setprop prepdecrypt.loglevel 2
    setprop prepdecrypt.setpatch true

on fs
    mkdir /mnt/vendor 0700 root root
    mount ext4 /dev/block/platform/bootdevice/by-name/vendor /vendor ro barrier=1

    # hwservicemanager is a "default" class service, so it is only started by
    # "class_start default" in on boot - i.e. after the recovery process has
    # already been forked. Start it here, once /vendor (and its vintf manifest)
    # is mounted, so the HIDL HALs below have a service manager to talk to.
    start hwservicemanager

    # teei_daemon talks to /dev/teei_client only and has no HIDL dependency.
    start teei_daemon

# keymaster/gatekeeper register with hwservicemanager, so they must not be
# started before it is serving. hwservicemanager sets this property when ready.
on property:hwservicemanager.ready=true
    start keymaster-4-0-beanpod
    start gatekeeper-1-0

on property:ro.crypto.state=encrypted && property:ro.crypto.type=file
    install_keyring

service keystore_auth /system/bin/keystore_auth
    oneshot
    user system
    group root
    disabled
    seclabel u:r:recovery:s0

service keystore /system/bin/keystore /tmp/misc/keystore
    user root
    group root drmrpc readproc
    disabled
    seclabel u:r:recovery:s0

service gatekeeper-1-0 /vendor/bin/hw/android.hardware.gatekeeper@1.0-service
    interface android.hardware.gatekeeper@1.0::IGatekeeper default
    user root
    group root
    disabled
    seclabel u:r:recovery:s0

service keymaster-4-0-beanpod /vendor/bin/hw/android.hardware.keymaster@4.0-service.beanpod
    interface android.hardware.keymaster@4.0::IKeymasterDevice default
    user root
    group root drmrpc
    disabled
    seclabel u:r:recovery:s0
    # Prefer the vendor copy of libkeymaster4 over the AOSP one relinked into
    # /system/lib64. Android 11 init renamed this service option from "env" to
    # "setenv" (host_init_verifier rejects "env" as an invalid keyword).
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64
